<Window x:Class="MouseMackros.MacroDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Макрос" Width="700" Height="650" WindowStyle="None" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" SnapsToDevicePixels="True" FontFamily="{StaticResource UiFont}"
        ShowInTaskbar="False">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource BgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#16191F">
                <TextBlock Text="Макрос действия" FontWeight="SemiBold" VerticalAlignment="Center"
                           Margin="16,0,0,0" />
                <Button Style="{StaticResource IconButton}" Content="✕" HorizontalAlignment="Right"
                        Margin="0,0,8,0" Click="Cancel_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            </Grid>

            <Grid Grid.Row="1" Margin="20,16,20,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="РЕЖИМ" Style="{StaticResource SectionTitle}" />
                        <ComboBox x:Name="ModeBox">
                            <ComboBoxItem Content="Один раз" />
                            <ComboBoxItem Content="Пока зажата" />
                            <ComboBoxItem Content="Вкл / выкл" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="ПОВТОРОВ" Style="{StaticResource SectionTitle}" />
                        <TextBox x:Name="RepeatBox" Text="0" ToolTip="0 = без дополнительных повторов" />
                    </StackPanel>
                </Grid>

                <TextBox Grid.Row="1" x:Name="ScriptBox" AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="12.5" Padding="8" />
                <TextBlock Grid.Row="2" Text="{Binding HelpText, RelativeSource={RelativeSource AncestorType=Window}}"
                           Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0"
                           TextWrapping="Wrap" />
                <TextBlock Grid.Row="3" Text="Каждая строка — шаг. Для фарма: press mouse:right + delay 5000, режим «Вкл / выкл»."
                           Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0"
                           TextWrapping="Wrap" />
            </Grid>

            <Border Grid.Row="2" Background="#16191F" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="16,12">
                <Grid>
                    <Button Style="{StaticResource GhostButton}" Content="Тест" HorizontalAlignment="Left"
                            Click="Test_Click" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource FlatButton}" Content="Отмена" Click="Cancel_Click" />
                        <Button Style="{StaticResource AccentButton}" Content="Сохранить" Margin="8,0,0,0"
                                Click="Save_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
