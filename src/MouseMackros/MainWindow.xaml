<Window x:Class="MouseMackros.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MouseMackros" Width="1160" Height="760" MinWidth="1000" MinHeight="640"
        WindowStyle="None" Background="{StaticResource BgBrush}" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource UiFont}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="#1E232C" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ChipText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="AppChip" TargetType="Border">
            <Setter Property="Background" Value="#1B2029" />
            <Setter Property="BorderBrush" Value="#2B323D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>

        <Style x:Key="MenuBarButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#C3CAD8" />
        </Style>

        <!-- ================= file menu ================= -->
        <ContextMenu x:Key="FileMenu">
            <MenuItem Header="Новый профиль" InputGestureText="Ctrl+N" Click="NewProfile_Click" />
            <MenuItem Header="Открыть профиль из файла…" Click="ImportProfile_Click" />
            <MenuItem Header="Сохранить профиль в файл…" Click="ExportProfile_Click" />
            <Separator />
            <MenuItem Header="Создать профиль для мыши (.psf)…" Click="GeneratePsf_Click" />
            <MenuItem Header="Записать нейтральную раскладку в мышь" Click="WriteMouse_Click" />
            <MenuItem Header="Записать нейтральную раскладку во все профили мыши" Click="WriteMouseAll_Click" />
            <MenuItem Header="Записать .psf в мышь…" Click="WritePsfToMouse_Click" />
            <MenuItem Header="HID-диагностика мыши…" Click="HidDiagnostics_Click" />
            <MenuItem Header="Загрузить раскладку .psf…" Click="LoadPsf_Click" />
            <MenuItem Header="Папка с профилями" Click="DataFolder_Click" />
            <Separator />
            <MenuItem Header="Настройки…" Click="Settings_Click" />
            <Separator />
            <MenuItem Header="Выход" Click="Exit_Click" />
        </ContextMenu>

        <!-- ================= profile menu ================= -->
        <ContextMenu x:Key="ProfileMenu">
            <MenuItem Header="Добавить приложение…" Click="AddApp_Click" />
            <MenuItem Header="Правила срабатывания…" Click="Rules_Click" />
            <MenuItem Header="Добавить подпрофиль…" Click="AddSubProfile_Click" />
            <MenuItem Header="Подпрофиль для текущего окна…" Click="AddSubProfileForWindow_Click" />
            <Separator />
            <MenuItem Header="Сделать основным" Click="MakeDefault_Click" />
            <MenuItem Header="Удалить профиль" Click="DeleteProfile_Click" />
        </ContextMenu>

        <!-- ================= edit menu ================= -->
        <ContextMenu x:Key="EditMenu">
            <MenuItem Header="Загрузить раскладку .psf…" Click="LoadPsf_Click" />
            <MenuItem Header="Создать профиль для мыши (.psf)…" Click="GeneratePsf_Click" />
            <Separator />
            <MenuItem Header="Диагностика ввода…" Click="Diagnostics_Click" />
        </ContextMenu>

        <!-- ================= help menu ================= -->
        <ContextMenu x:Key="HelpMenu">
            <MenuItem Header="Диагностика ввода…" Click="Diagnostics_Click" />
            <MenuItem Header="О программе" Click="About_Click" />
        </ContextMenu>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource BgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <!-- ================= title + menu bar ================= -->
            <Grid Grid.Row="0" Background="#16191F">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="16,0,14,0" VerticalAlignment="Center">
                    <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="M" FontWeight="Bold" FontSize="13" Foreground="#0E1626"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="MouseMackros" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="FileMenuButton" Style="{StaticResource MenuBarButton}" Content="Файл"
                            Click="FileMenuButton_Click" />
                    <Button x:Name="ProfileMenuButton" Style="{StaticResource MenuBarButton}" Content="Профиль"
                            Click="ProfileMenuButton_Click" />
                    <Button x:Name="EditMenuButton" Style="{StaticResource MenuBarButton}" Content="Изменить"
                            Click="EditMenuButton_Click" />
                    <Button x:Name="HelpMenuButton" Style="{StaticResource MenuBarButton}" Content="Справка"
                            Click="HelpMenuButton_Click" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="PauseButton" Style="{StaticResource FlatButton}" Click="PauseButton_Click"
                            ToolTip="Ctrl+Alt+P" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource SuccessBrush}"
                                     VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock x:Name="StatusText" Text="Активно" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Content="—" Click="MinimizeButton_Click"
                            ToolTip="Свернуть" />
                    <Button Style="{StaticResource IconButton}" Content="✕" Click="CloseButton_Click"
                            ToolTip="Скрыть в трей" />
                </StackPanel>
            </Grid>

            <!-- ================= body ================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="304" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- profiles panel -->
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,1,0" Background="#15181E">
                    <Grid Margin="12,14,12,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="4,0,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="ПРОФИЛИ" Style="{StaticResource SectionTitle}" Margin="0" />
                                <TextBlock x:Name="ProfileCountText" Style="{StaticResource MutedText}"
                                           FontSize="11" Margin="8,0,0,1" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Style="{StaticResource IconButton}" Content="＋" HorizontalAlignment="Right"
                                    Margin="0,-4,0,0" Click="NewProfile_Click" ToolTip="Новый профиль (Ctrl+N)" />
                        </Grid>

                        <ListBox x:Name="ProfileList" Grid.Row="1" SelectionChanged="ProfileList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="{Binding IndentWidth}" />

                                        <Grid Grid.Column="1" Width="34" Height="34" Margin="0,0,10,0">
                                            <Border CornerRadius="8" Background="{Binding Accent}" Opacity="0.9">
                                                <TextBlock Text="{Binding Initial}" FontWeight="Bold" FontSize="14"
                                                           Foreground="#0E1626" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <Image Source="{Binding Icon}" Width="24" Height="24" />
                                        </Grid>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}"
                                                       FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <Ellipse Grid.Column="3" Width="7" Height="7" Fill="{StaticResource SuccessBrush}"
                                                 VerticalAlignment="Center" Margin="6,0,2,0"
                                                 Visibility="{Binding ActiveVisibility}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="2" Margin="4,10,4,0">
                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,10" />
                            <TextBlock Text="1) Подключите мышь (USB или ресивер)."
                                       Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
                            <TextBlock Text="2) Нажмите «Настроить мышь» — запишется нейтральная раскладка."
                                       Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap"
                                       Margin="0,2,0,10" />
                            <Button Style="{StaticResource GhostButton}" Content="Настройки…"
                                    HorizontalContentAlignment="Left" Padding="6,4" Click="Settings_Click" />
                            <Button Style="{StaticResource GhostButton}" Content="Папка с профилями"
                                    HorizontalContentAlignment="Left" Padding="6,4" Click="DataFolder_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- profile content -->
                <Grid Grid.Column="1" Margin="22,18,22,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- header card -->
                    <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12"
                            Padding="18,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Width="56" Height="56" VerticalAlignment="Top">
                                <Border CornerRadius="12" Background="#232935" BorderBrush="#313846"
                                        BorderThickness="1">
                                    <TextBlock x:Name="HeaderInitial" FontSize="22" FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Image x:Name="HeaderIcon" Width="38" Height="38" />
                            </Grid>

                            <StackPanel Grid.Column="1" Margin="14,0,18,0" VerticalAlignment="Center">
                                <TextBox x:Name="ProfileNameBox" Style="{StaticResource InlineTextBox}"
                                         TextChanged="ProfileNameBox_TextChanged" ToolTip="Имя профиля" />
                                <ItemsControl x:Name="AppsList" Margin="0,7,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource AppChip}" ToolTip="{Binding Path}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="11.5"
                                                               VerticalAlignment="Center" />
                                                    <Button Style="{StaticResource GhostButton}" Content="✕"
                                                            Padding="4,0" Margin="3,0,0,0" MinWidth="14"
                                                            Click="RemoveApp_Click" ToolTip="Убрать приложение" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="NoAppsText" Style="{StaticResource MutedText}" FontSize="11.5"
                                           Margin="2,2,0,0" Text="Приложение не выбрано" />
                                <WrapPanel Margin="0,9,0,0">
                                    <Border Style="{StaticResource Chip}">
                                        <TextBlock x:Name="RulesChipText" Style="{StaticResource ChipText}" />
                                    </Border>
                                    <Border Style="{StaticResource Chip}">
                                        <TextBlock x:Name="PsfChipText" Style="{StaticResource ChipText}" />
                                    </Border>
                                    <Border x:Name="FallbackChip" Style="{StaticResource Chip}">
                                        <TextBlock Text="основной профиль" Style="{StaticResource ChipText}"
                                                   Foreground="#7FB2FF" />
                                    </Border>
                                    <Border x:Name="SubProfileChip" Style="{StaticResource Chip}"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="SubProfileChipText" Style="{StaticResource ChipText}"
                                                   Foreground="#C3A0FF" />
                                    </Border>
                                </WrapPanel>
                                <Border x:Name="VendorBanner" Background="#2A2318" BorderBrush="#5A4420"
                                        BorderThickness="1" CornerRadius="7" Padding="8,5" Margin="0,2,0,0"
                                        Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="VendorStatusText" FontSize="11" Foreground="#F2A33C"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                                        <Button x:Name="VendorFixButton" Grid.Column="1"
                                                Style="{StaticResource GhostButton}"
                                                Content="как настроить" Padding="2,0" Margin="7,0,0,0"
                                                FontSize="11" Foreground="#7FB2FF" Click="GeneratePsf_Click"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <Button Style="{StaticResource FlatButton}" Content="Добавить приложение…"
                                        Click="AddApp_Click" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="RulesButton" Style="{StaticResource GhostButton}" Content="Правила…"
                                            Click="Rules_Click" Padding="8,5" ToolTip="Заголовок, класс, приоритет" />
                                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Раскладка .psf…"
                                            Click="LoadPsf_Click" Padding="8,5"
                                            ToolTip="Прочитать действия кнопок из файла MBF1000PRO" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- buttons -->
                    <Grid Grid.Row="1" Margin="0,18,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="2,0,2,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="КНОПКИ" Style="{StaticResource SectionTitle}" Margin="0" />
                                <TextBlock x:Name="BindingCountText" Style="{StaticResource MutedText}"
                                           FontSize="11" Margin="8,0,0,1" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock x:Name="PsfSourceText" Style="{StaticResource MutedText}" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                                <Button Style="{StaticResource GhostButton}" Content="Настроить мышь"
                                        Click="WriteMouse_Click" Padding="8,4" Margin="0,0,6,0"
                                        ToolTip="Записать Ctrl+Alt+Shift+A…M напрямую в мышь" />
                                <Button Style="{StaticResource GhostButton}" Content="Загрузить .psf…"
                                        Click="LoadPsf_Click" Padding="8,4" />
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,4,0">
                                <ItemsControl x:Name="ButtonsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource PanelBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="10" Padding="12,10"
                                                    Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="1.05*" />
                                                        <ColumnDefinition Width="1.35*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="34" Height="34" CornerRadius="8"
                                                            Background="{Binding AccentBackground}"
                                                            VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding NumberText}" FontWeight="Bold"
                                                                   FontSize="13" Foreground="{Binding Accent}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding TriggerText}"
                                                                   Style="{StaticResource MutedText}" FontSize="11"
                                                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                                Margin="8,0,10,0">
                                                        <TextBlock Text="{Binding ActionSummary}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding ActionDetail}"
                                                                   Style="{StaticResource MutedText}" FontSize="11"
                                                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <Button Style="{StaticResource GhostButton}" Content="Тест"
                                                                Padding="8,4" Click="TestBinding_Click" />
                                                        <Button Style="{StaticResource GhostButton}" Content="Подпись…"
                                                                Padding="8,4" Margin="2,0,0,0"
                                                                Click="Label_Click"
                                                                ToolTip="Понятная пометка, что делает кнопка" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border x:Name="EmptyState" Background="#171B21" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="12" Padding="26,30" Margin="0,4,0,0"
                                        Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock x:Name="EmptyTitle" Text="Раскладка .psf не загружена" FontSize="14"
                                                   FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="EmptyHint"
                                                   Text="Загрузите .psf из MBF1000PRO — действия кнопок появятся здесь автоматически."
                                                   Style="{StaticResource MutedText}" Margin="0,7,0,0"
                                                   HorizontalAlignment="Center" TextWrapping="Wrap"
                                                   TextAlignment="Center" MaxWidth="520" />
                                        <Button Style="{StaticResource AccentButton}" Content="Загрузить .psf…"
                                                Margin="0,16,0,0" HorizontalAlignment="Center"
                                                Click="LoadPsf_Click" />
                                        <TextBlock Text="Для автоматического переключения мышь должна быть настроена на MouseMackros.psf (Файл → Создать профиль для мыши)."
                                                   Style="{StaticResource MutedText}" FontSize="10.5" Margin="0,14,0,0"
                                                   HorizontalAlignment="Center" TextWrapping="Wrap"
                                                   TextAlignment="Center" MaxWidth="520" />
                                    </StackPanel>
                                </Border>

                                <StackPanel x:Name="OtherSection" Margin="0,18,2,0" Visibility="Collapsed">
                                    <TextBlock Text="ДРУГИЕ ПРИВЯЗКИ" Style="{StaticResource SectionTitle}" />
                                    <ItemsControl x:Name="OtherList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#171B21" BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="8" Padding="12,8"
                                                        Margin="0,0,0,5">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1*" />
                                                            <ColumnDefinition Width="1.4*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding TriggerText}"
                                                                       Style="{StaticResource MutedText}" FontSize="11"
                                                                       Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                                    Margin="8,0,10,0">
                                                            <TextBlock Text="{Binding ActionSummary}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding ActionDetail}"
                                                                       Style="{StaticResource MutedText}" FontSize="11"
                                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                    VerticalAlignment="Center">
                                                            <Button Style="{StaticResource GhostButton}" Content="Тест"
                                                                    Padding="8,4" Click="TestBinding_Click" />
                                                            <Button Style="{StaticResource GhostButton}" Content="Подпись…"
                                                                    Padding="8,4" Margin="2,0,0,0"
                                                                    Click="Label_Click" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ================= status bar ================= -->
            <Border Grid.Row="2" Background="#16191F" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="16,0">
                    <TextBlock x:Name="LastInputText" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                               FontSize="11" Text="Готово" />
                    <TextBlock x:Name="ActiveWindowText" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                               HorizontalAlignment="Right" FontSize="11" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
