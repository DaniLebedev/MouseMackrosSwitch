<Window x:Class="MouseMackros.TriggerLearnDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Нажмите кнопку" Width="440" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="Transparent" AllowsTransparency="True">
    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            CornerRadius="10" Padding="24">
        <StackPanel>
            <TextBlock Text="Какую кнопку назначить?" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="Нажмите любую кнопку мыши или сочетание клавиш. Это окно закроется само."
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0" />

            <Border Background="#11141A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="14" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock x:Name="ComboText" Text="Ожидание…" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock x:Name="SourceText" Style="{StaticResource MutedText}" HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="HintText" Style="{StaticResource MutedText}" Margin="0,14,0,0"
                       TextWrapping="Wrap"
                       Text="Совет: боковые кнопки мыши должны быть настроены в MBF1000PRO на сочетания Ctrl+Alt+Shift+A…M. Готовый файл создаётся в меню «Файл → Создать профиль для мыши (.psf)…»." />

            <Button Content="Отмена" Style="{StaticResource FlatButton}" HorizontalAlignment="Right"
                    Margin="0,18,0,0" Click="Cancel_Click" />
        </StackPanel>
    </Border>
</Window>
