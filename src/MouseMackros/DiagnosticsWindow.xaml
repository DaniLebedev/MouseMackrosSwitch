<Window x:Class="MouseMackros.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Захват ввода" Width="560" Height="480"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="Transparent" AllowsTransparency="True">
    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            CornerRadius="10" Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <TextBlock Text="Что присылает мышь" FontSize="17" FontWeight="SemiBold" />
                <Button Style="{StaticResource IconButton}" Content="✕" HorizontalAlignment="Right"
                        Click="Close_Click" />
            </Grid>

            <TextBlock Grid.Row="1" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,14"
                       Text="Нажимайте кнопки мыши. Сюда попадает всё, что перехватывает MouseMackros: боковые кнопки, колесо и любые сочетания клавиш. Если кнопка не появляется — значит мышь не отправляет для неё отдельный сигнал: назначьте ей сочетание в MBF1000PRO Mouse." />

            <Border Grid.Row="2" Background="#11141A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8">
                <ListBox x:Name="EventList" Margin="8" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Time}" Style="{StaticResource MutedText}" FontFamily="Consolas" />
                                <TextBlock Grid.Column="1" Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Grid Grid.Row="3" Margin="0,16,0,0">
                <TextBlock x:Name="CounterText" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                <Button Content="Очистить" Style="{StaticResource FlatButton}" HorizontalAlignment="Right"
                        Click="Clear_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
