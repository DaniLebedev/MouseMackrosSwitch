<Window x:Class="MouseMackros.LayersDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Ручные раскладки" Width="720" Height="720" WindowStyle="None" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" SnapsToDevicePixels="True" FontFamily="{StaticResource UiFont}"
        ShowInTaskbar="False">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource BgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#16191F">
                <TextBlock Text="Ручные раскладки" FontWeight="SemiBold" VerticalAlignment="Center"
                           Margin="16,0,0,0" />
                <Button Style="{StaticResource IconButton}" Content="✕" HorizontalAlignment="Right"
                        Margin="0,0,8,0" Click="Cancel_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Margin="20,16,20,8">
                <StackPanel HorizontalAlignment="Stretch">
                    <TextBlock Text="ПРОФИЛЬ" Style="{StaticResource SectionTitle}" />
                    <TextBlock x:Name="ParentText" FontSize="13" Margin="0,2,0,0" />

                    <TextBlock Text="ЦВЕТ КОЛЕСА ПРОФИЛЯ" Style="{StaticResource SectionTitle}" Margin="0,16,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ParentColorBox" ToolTip="RRGGBB или #RRGGBB" />
                        <Border Grid.Column="1" x:Name="ParentColorPreview" Width="26" Height="26"
                                CornerRadius="5" Margin="8,0,0,0" BorderThickness="1" BorderBrush="#313846" />
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Проверить"
                                Padding="10,5" Margin="8,0,0,0" Click="PreviewColor_Click"
                                ToolTip="Записать этот цвет в колесо сейчас" />
                    </Grid>
                    <TextBlock Text="Пусто — не менять цвет колеса для этого профиля."
                               Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="КНОПКА «СЛЕДУЮЩИЙ СЛОЙ»" Style="{StaticResource SectionTitle}" />
                            <ComboBox x:Name="NextButtonBox" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="КНОПКА «ПРЕДЫДУЩИЙ СЛОЙ»" Style="{StaticResource SectionTitle}" />
                            <ComboBox x:Name="PrevButtonBox" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Одна кнопка листает вперёд по кругу. Две кнопки листают вперёд и назад. Кнопки работают во всём профиле и имеют приоритет над действиями слоя. 12/13/14 — это ЛКМ/ПКМ/СКМ: если назначить их, обычный клик в этом профиле будет перехвачен."
                               Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0"
                               TextWrapping="Wrap" />

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16,0,12" />

                    <Grid>
                        <TextBlock Text="СЛОИ" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GhostButton}" Content="Добавить" Padding="10,5"
                                    Click="AddLayer_Click" />
                            <Button Style="{StaticResource GhostButton}" Content="Удалить" Padding="10,5"
                                    Margin="6,0,0,0" Click="RemoveLayer_Click" />
                        </StackPanel>
                    </Grid>

                    <ListBox x:Name="LayersList" Height="170" Margin="0,8,0,0"
                             SelectionChanged="LayersList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="22" Height="22" CornerRadius="5" Background="{Binding Color}"
                                            BorderBrush="#313846" BorderThickness="1" />
                                    <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}"
                                                   FontSize="11" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding ColorText}"
                                               Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="ЦВЕТ ВЫБРАННОГО СЛОЯ" Style="{StaticResource SectionTitle}" Margin="0,12,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="LayerColorBox" ToolTip="RRGGBB или #RRGGBB" />
                        <Border Grid.Column="1" x:Name="LayerColorPreview" Width="26" Height="26"
                                CornerRadius="5" Margin="8,0,0,0" BorderThickness="1" BorderBrush="#313846" />
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Сохранить цвет"
                                Padding="10,5" Margin="8,0,0,0" Click="SaveLayerColor_Click" />
                        <Button Grid.Column="3" Style="{StaticResource GhostButton}" Content="Загрузить .psf…"
                                Padding="10,5" Margin="8,0,0,0" Click="LoadLayerPsf_Click" />
                    </Grid>
                    <TextBlock Text="Цвет слоя имеет приоритет над цветом профиля при переключении слоёв. Для колеса используются 8 DPI-цветов; MouseMackros выставляет их все в один цвет."
                               Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="#16191F" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="16,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource FlatButton}" Content="Отмена" Click="Cancel_Click" />
                    <Button Style="{StaticResource AccentButton}" Content="Сохранить" Margin="8,0,0,0"
                            Click="Save_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
