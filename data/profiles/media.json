{
  "Id": "media",
  "Name": "Музыка и видео",
  "Accent": "#9B6BF2",
  "Applications": [],
  "PsfRevision": 0,
  "Match": {
    "Processes": [
      "spotify",
      "vlc",
      "aimp",
      "musicbee",
      "foobar2000",
      "wmplayer",
      "mpc-hc64",
      "mpc-be64"
    ],
    "Priority": 10
  },
  "Bindings": [
    {
      "Button": 1,
      "Trigger": "key:Ctrl+Shift+Alt+A",
      "Label": "Play / пауза",
      "Action": {
        "Kind": "Media",
        "Value": "PlayPause",
        "Mode": "Once",
        "Repeat": 0
      },
      "Enabled": true
    },
    {
      "Button": 2,
      "Trigger": "key:Ctrl+Shift+Alt+B",
      "Label": "Следующий трек",
      "Action": {
        "Kind": "Media",
        "Value": "Next",
        "Mode": "Once",
        "Repeat": 0
      },
      "Enabled": true
    },
    {
      "Button": 3,
      "Trigger": "key:Ctrl+Shift+Alt+C",
      "Label": "Предыдущий трек",
      "Action": {
        "Kind": "Media",
        "Value": "Previous",
        "Mode": "Once",
        "Repeat": 0
      },
      "Enabled": true
    },
    {
      "Button": 4,
      "Trigger": "key:Ctrl+Shift+Alt+D",
      "Label": "Стоп",
      "Action": {
        "Kind": "Media",
        "Value": "Stop",
        "Mode": "Once",
        "Repeat": 0
      },
      "Enabled": true
    },
    {
      "Button": 5,
      "Trigger": "key:Ctrl+Shift+Alt+E",
      "Label": "Громче",
      "Action": {
        "Kind": "Media",
        "Value": "VolumeUp",
        "Mode": "Once",
        "Repeat": 0
      },
      "Enabled": true
    },
    {
      "Button": 6,
      "Trigger": "key:Ctrl+Shift+Alt+F",
      "Label": "Тише",
      "Action": {
        "Kind": "Media",
        "Value": "VolumeDown",
        "Mode": "Once",
        "Repeat": 0
      },
      "Enabled": true
    },
    {
      "Button": 7,
      "Trigger": "key:Ctrl+Shift+Alt+G",
      "Label": "Без звука",
      "Action": {
        "Kind": "Media",
        "Value": "VolumeMute",
        "Mode": "Once",
        "Repeat": 0
      },
      "Enabled": true
    }
  ],
  "IsFallback": false
}