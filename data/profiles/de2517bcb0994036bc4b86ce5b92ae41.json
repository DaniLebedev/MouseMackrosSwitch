{
  "Id": "de2517bcb0994036bc4b86ce5b92ae41",
  "Name": "Браузер — Nexus",
  "Accent": "#4C9AFF",
  "Applications": [
    "C:\\Program Files\\Mozilla Firefox\\firefox.exe"
  ],
  "ApplicationPath": "C:\\Program Files\\Mozilla Firefox\\firefox.exe",
  "VendorProfilePath": "D:\\Projects\\MouseMackrosSwitch\\data\\psf\\firefox_Nexus.psf",
  "PsfRevision": 4,
  "Match": {
    "Processes": [
      "chrome",
      "msedge",
      "firefox",
      "brave",
      "opera",
      "vivaldi",
      "browser",
      "yandex",
      "librewolf",
      "thorium",
      "arc"
    ],
    "Expression": "browser.url contains \"https://www.nexusmods.com\"",
    "Priority": 20
  },
  "Bindings": [
    {
      "Button": 2,
      "Trigger": "key:Ctrl+Shift+Alt+B",
      "Label": "tab left",
      "Action": {
        "Kind": "Macro",
        "Value": "",
        "Script": "browser change_param \"page\" +1",
        "Mode": "Once",
        "Repeat": 0
      },
      "Enabled": true
    },
    {
      "Button": 3,
      "Trigger": "key:Ctrl+Shift+Alt+C",
      "Label": "tab left",
      "Action": {
        "Kind": "Keys",
        "Value": "Ctrl+Shift+Tab",
        "Mode": "Once",
        "Repeat": 0
      },
      "Enabled": true
    },
    {
      "Button": 4,
      "Trigger": "key:Ctrl+Shift+Alt+D",
      "Label": "Forward",
      "Action": {
        "Kind": "Macro",
        "Value": "",
        "Script": "press mouse:x2",
        "Mode": "Once",
        "Repeat": 0
      },
      "Enabled": true
    },
    {
      "Button": 5,
      "Trigger": "key:Ctrl+Shift+Alt+E",
      "Label": "tab right",
      "Action": {
        "Kind": "Macro",
        "Value": "",
        "Script": "browser change_param \"page\" -1",
        "Mode": "Once",
        "Repeat": 0
      },
      "Enabled": true
    },
    {
      "Button": 6,
      "Trigger": "key:Ctrl+Shift+Alt+F",
      "Label": "tab right",
      "Action": {
        "Kind": "Keys",
        "Value": "Ctrl+Tab",
        "Mode": "Once",
        "Repeat": 0
      },
      "Enabled": true
    },
    {
      "Button": 9,
      "Trigger": "key:Ctrl+Shift+Alt+I",
      "Label": "Backward",
      "Action": {
        "Kind": "Macro",
        "Value": "",
        "Script": "press mouse:x1",
        "Mode": "Once",
        "Repeat": 0
      },
      "Enabled": true
    }
  ],
  "IsFallback": false,
  "ParentId": "browser",
  "IsManualLayer": false,
  "LayerOrder": 0,
  "IndicatorColor": "#FF0000",
  "LayerNextButton": 0,
  "LayerPrevButton": 0
